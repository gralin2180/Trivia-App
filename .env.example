# Copy this file to `.env` in the project root, then restart the dev server.
# Supabase Dashboard → Project Settings → API Keys
#
# IMPORTANT: For auth to work reliably right now, use the LEGACY "anon" key
# (long string starting with eyJ...), NOT the short sb_publishable_ key.
# On the API Keys page, open "Legacy API keys" or scroll to find "anon public".

EXPO_PUBLIC_SUPABASE_URL=https://rfzkejayduahibfifwxq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-legacy-anon-key-starting-with-eyJ

# Python AI pipeline (FastAPI). Use LAN IP for Expo Go on phone.
# EXPO_PUBLIC_AI_API_URL=http://localhost:8000
# EXPO_PUBLIC_AI_API_URL=http://192.168.0.116:8000

# Social sign-in (configure in Supabase Dashboard, not here):
# 1. Authentication → Providers → enable Google and Apple
# 2. Authentication → URL Configuration → add redirect URLs:
#    - triviaapp://auth/callback
#    - exp://127.0.0.1:8081/--/auth/callback (simulator)
#    - exp://YOUR_PC_IP:PORT/--/auth/callback (Expo Go on phone — shown on login screen in dev)
# 3. Google Cloud → OAuth consent screen → Authorized domains → add: supabase.co
# 4. Google Cloud → OAuth client → redirect URI:
#    https://rfzkejayduahibfifwxq.supabase.co/auth/v1/callback
# 5. Google: add tester emails under OAuth consent screen → Test users (while app is in Testing)
